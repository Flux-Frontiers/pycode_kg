# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
build/
dist/
wheels/
.eggs/
*.egg-info/
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.envrc
.venv
env/
venv/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Logs
*.log

# PyPI configuration file
.pypirc

# Visual Studio Code
#  .vscode/ is tracked to preserve project-specific config (tasks, settings, MCP)

# Cursor
#  `.cursorignore` specifies files/directories to exclude from AI features.
.cursorignore
.cursorindexingignore

# LaTeX intermediate files
*.aux
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# PyCodeKG generated artifacts — databases are transient/reproducible, snapshots are tracked
# MUST include .pycodekg/snapshots!
.pycodekg/lancedb/
.pycodekg/lancedb-*
.pycodekg/vectors.sqlite
.pycodekg/vectors.sqlite*
.pycodekg/graph.sqlite
.pycodekg/graph.sqlite*
.pycodekg/models

# DocKG generated artifacts — same pattern as PyCodeKG; snapshots will be tracked once added
.dockg/lancedb/
.dockg/lancedb-*
.dockg/graph.sqlite
.dockg/graph.sqlite*
.dockg/embeddings.json
.dockg/models

# DiaryKG generated artifacts — same pattern as PyCodeKG
.diarykg/lancedb/
.diarykg/lancedb-*
.diarykg/graph.sqlite
.diarykg/graph.sqlite*
.diarykg/models

# AgentKG
.agentkg/

# Local MCP configuration (contains absolute paths — copy .mcp.json.template)
.mcp.json

# macOS
**/.DS_Store

# Commit-message scratch file (written by /changelog-commit)
commit.txt

# Large asset files (> 1MB)
assets/*-1024x1024.png
assets/*-xl-*.png
assets/pycode_kg_arch_*.png

# Misc
bundles/
uv.lock
